# Application Configuration Example
PROJECT_NAME="MPLADS Risk Intelligence & Investigation Platform"
PROJECT_SLUG="mplads-risk-intelligence"
API_V1_STR="/api/v1"

# Database Configuration (Defaults to local SQLite WAL database)
# DATABASE_URL="sqlite:///data/mplads.db"
# For PostgreSQL / pgvector production deployments:
# DATABASE_URL="postgresql://user:password@localhost:5432/mplads"

# Official eSAKSHI MoSPI Endpoints
ESAKSHI_BASE_URL="https://mplads.mospi.gov.in"
ESAKSHI_REST_PATH="/rest/PreLoginDashboardData"

# Anomaly Thresholds
STATUTORY_STALL_DAYS=365
TENDER_THRESHOLD_INR=1000000.0
TRUST_SOCIETY_CAP_INR=7500000.0
DUPLICATE_PROXIMITY_METERS=500.0
DUPLICATE_TEXT_SIMILARITY=0.80
MODIFIED_Z_SCORE_THRESHOLD=3.0
ADVANCE_PROGRESS_GAP_THRESHOLD=50.0
